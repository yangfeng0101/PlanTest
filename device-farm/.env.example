# ==================== 数据库配置 ====================
DB_HOST=localhost
DB_PORT=5432
DB_USER=devicefarm
DB_PASSWORD=your_db_password
DB_NAME=device_farm

# ==================== Redis 配置 ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# ==================== MinIO 配置 ====================
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USER=your_minio_user
MINIO_PASSWORD=your_minio_password
MINIO_BUCKET=device-farm
MINIO_USE_SSL=false

# ==================== 服务端口 (开发环境下) ====================
# 这些端口应与 frontend/vite.config.ts 中的代理设置保持一致
DEVICE_SVC_PORT=8001
SCREEN_SVC_PORT=8002
TEST_SVC_PORT=8003
REPORT_SVC_PORT=8004
NGINX_PORT=80

# ==================== JWT 配置 ====================
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# ==================== 日志配置 ====================
LOG_LEVEL=info
LOG_FORMAT=json

# ==================== 存储配置 ====================
VIDEO_STORAGE_PATH=/data/videos
LOG_STORAGE_PATH=/data/logs
REPORT_STORAGE_PATH=/data/reports

# ==================== WebRTC 配置 ====================
# 手机访问投屏时，LiveKit 必须向浏览器公布本机局域网 IP。
# dev.sh 会自动探测并写入 .env；手动启动 compose 时请按当前网络修改。
LIVEKIT_PUBLIC_HOST=192.168.1.100
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=turn:turn.example.com:3478
TURN_USERNAME=your_turn_user
TURN_PASSWORD=your_turn_password

# ==================== Midscene AI 脚本能力 ====================
# midscene-runner 仅在 Docker 内网暴露，不映射宿主机端口。
# 密钥只注入 runner，不要写入脚本或前端页面。
MIDSCENE_MODEL_NAME=your_model_name
MIDSCENE_MODEL_BASE_URL=https://your-model-endpoint.example.com/v1
MIDSCENE_MODEL_API_KEY=your_model_api_key
MIDSCENE_MODEL_FAMILY=your_model_family
MIDSCENE_CACHE=true
