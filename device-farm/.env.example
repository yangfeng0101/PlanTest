# ==================== 数据库配置 ====================
DB_HOST=localhost
DB_PORT=5432
DB_USER=devicefarm
DB_PASSWORD=your_db_password
DB_NAME=device_farm

# ==================== Redis 配置 ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# ==================== MinIO 配置 ====================
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USER=your_minio_user
MINIO_PASSWORD=your_minio_password
MINIO_BUCKET=device-farm
MINIO_USE_SSL=false

# ==================== 服务端口 (开发环境下) ====================
# 这些端口应与 frontend/vite.config.ts 中的代理设置保持一致
DEVICE_SVC_PORT=8001
SCREEN_SVC_PORT=8002
TEST_SVC_PORT=8003
REPORT_SVC_PORT=8004
AI_SVC_PORT=8005
NGINX_PORT=80

# ==================== JWT 配置 ====================
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# ==================== 日志配置 ====================
LOG_LEVEL=info
LOG_FORMAT=json

# ==================== 存储配置 ====================
VIDEO_STORAGE_PATH=/data/videos
LOG_STORAGE_PATH=/data/logs
REPORT_STORAGE_PATH=/data/reports

# ==================== WebRTC 配置 ====================
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=turn:turn.example.com:3478
TURN_USERNAME=your_turn_user
TURN_PASSWORD=your_turn_password

# ==================== AI 服务配置 ====================
# OCR 引擎 (paddleocr/tesseract)
OCR_ENGINE=paddleocr
# AI 模型名称 (UI-TARS / Qwen-VL)
AI_MODEL=UI-TARS
AI_API_KEY=your_ai_api_key
