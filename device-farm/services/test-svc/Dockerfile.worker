# Celery Worker Dockerfile
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    android-tools-adb \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY test-svc/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt -i https://pypi.tuna.tsinghua.edu.cn/simple

# Copy application code
COPY test-svc/ .

# Copy shared modules
COPY shared/ ./shared/

# Set PYTHONPATH to include the current directory so 'app' and 'shared' can be found
ENV PYTHONPATH=/app

# Create directories
RUN mkdir -p /tmp/device-farm/scripts

# Run celery worker
CMD ["celery", "-A", "app.tasks", "worker", "--loglevel=info", "--concurrency=2"]
