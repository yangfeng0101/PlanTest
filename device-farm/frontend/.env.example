# Device Service
VITE_DEVICE_SVC_URL=http://localhost:8081

# Screen Service
# Leave WS URL empty so the Vite /ws proxy handles the Android LiveKit
# screen-streaming path. The iOS MJPEG-direct preview is HTTP-only and
# does not need any WS URL here.
VITE_SCREEN_WS_URL=
VITE_SCREEN_HTTP_URL=http://localhost:8002

# Test Service
VITE_TEST_SVC_URL=http://localhost:8083

# Report Service
VITE_REPORT_SVC_URL=http://localhost:8082
